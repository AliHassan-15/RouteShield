# Each example is safe text; do not commit real .env files.
# APP_ENV: optional locally (development); required for production (production).
APP_ENV=development
# DEBUG: optional; local true, production false (true is rejected in production).
DEBUG=true
# APP_VERSION: optional release label returned by health.
APP_VERSION=0.1.0
# SECRET_KEY: optional locally (public insecure placeholder); required strong external secret
# in production. Empty example is intentional; user supplies their own secret.
SECRET_KEY=
# ALLOWED_HOSTS: local defaults shown; required explicit production hostnames, no wildcard.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# CORS_ALLOWED_ORIGINS: local defaults shown; required explicit HTTPS production origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# TRUST_PROXY_SSL_HEADER: optional false; true only behind a trusted TLS reverse proxy.
TRUST_PROXY_SSL_HEADER=false
# ROUTING_PROVIDER / WEATHER_PROVIDER: optional approved selectors, no adapter calls yet.
ROUTING_PROVIDER=tomtom
WEATHER_PROVIDER=open_meteo
# TOMTOM_API_KEY: optional for foundation health; required later for live TomTom features.
# Keep it server-side. Never paste a real value into chat or this example.
TOMTOM_API_KEY=
# Optional positive seconds. Every operation is bounded by the remaining global deadline.
# Connect<=3, routing read<=25, geocode read<=8; routing timeouts are never retried.
PROVIDER_CONNECT_TIMEOUT_SECONDS=3
ROUTING_READ_TIMEOUT_SECONDS=25
WEATHER_READ_TIMEOUT_SECONDS=8
GEOCODE_READ_TIMEOUT_SECONDS=8
ANALYSIS_DEADLINE_SECONDS=35
# Optional total geocoding attempts (1 or 2); only connection/502/503/504 retry.
# Routing always makes one attempt, except the approved past-departure correction.
PROVIDER_ATTEMPTS=2
# Optional provider start-rate bound (1..5 calls/rolling second), default 5.
PROVIDER_REQUESTS_PER_SECOND=5
# Optional concurrent provider-call bound (1..2), default 2; share one limiter.
PROVIDER_CALL_CONCURRENCY=2
# Optional transient geocoding backoff seconds (0..0.5), default 0.5.
# A valid longer Retry-After is honored only if the remaining deadline can fit it.
PROVIDER_RETRY_BACKOFF_SECONDS=0.5
# Optional local cache namespace and successful-weather TTL in seconds (1..900).
CACHE_NAMESPACE=routeshield
WEATHER_CACHE_TTL_SECONDS=900
# Optional successful normalized-series cache capacity, positive entries (default 400).
WEATHER_CACHE_MAX_ENTRIES=400
# Optional weather endpoint, HTTPS without embedded credentials/query. Free endpoint needs no key.
# Free-service eligibility remains a user-owned release gate; set an eligible endpoint before release.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
# Optional requested model selection; best_match measured complete for the tested days 7-11 window.
OPEN_METEO_MODEL=best_match
# Optional weather attempts (1..2); only connection/502/503/504 retry.
WEATHER_ATTEMPTS=2
# Optional positive weather transient backoff (<=0.5 seconds); Retry-After must fit the deadline.
WEATHER_RETRY_BACKOFF_SECONDS=0.5
# Optional in-process daily UTC quota stop and per-upstream-batch reservation guard, positive units.
# Retries consume units too. Restart resets the best-effort ledger.
WEATHER_DAILY_QUOTA_UNITS=8000
WEATHER_REQUEST_UNIT_LIMIT=200
# Optional display-only gusts; fifth variable stays within the published <=10-variable base charge.
WEATHER_GUSTS_ENABLED=false
# Optional approved application budgets; quota measurement still gates orchestration.
# A legacy value above 200 is bounded at 200; optional density is disclosed by pooling.
MAX_WEATHER_COORDINATES=200
WEATHER_BATCH_SIZE=50
WEATHER_BATCH_CONCURRENCY=2
# Optional future per-IP throttle settings; only configured, not used by health.
ANALYSIS_RATE_LIMIT=10
ANALYSIS_RATE_WINDOW_SECONDS=600
GEOCODE_RATE_LIMIT=30
GEOCODE_RATE_WINDOW_SECONDS=60
# Optional false. Scenario features are not implemented by this foundation.
SIMULATION_ENABLED=false
