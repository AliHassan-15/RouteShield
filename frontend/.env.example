# Optional in development; REQUIRED for production builds. Public backend API prefix.
# HTTPS, /api/v1/ and trailing slash required in production; localhost is rejected.
# Local example: http://localhost:8000/api/v1/
# Production example: https://your-backend.example/api/v1/
# Never place provider keys or SECRET_KEY in VITE_* variables.
VITE_API_BASE_URL=http://localhost:8000/api/v1/

# Optional public basemap endpoints. Defaults shown; no key or account required.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
VITE_MAP_GLYPHS_URL=https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf
VITE_MAP_SPRITE_URL=https://tiles.openfreemap.org/sprites/ofm_f384/ofm
# Optional: true uses an offline background style with no basemap requests.
VITE_MAP_OFFLINE=false
# Optional test-only debug hook. Keep false/unset in production; build checks it.
VITE_E2E=false
